/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the Paplu Pro application.
 *
 * Core Philosophy:
 *   The rules prioritize security by default. Only authenticated users can create game sessions and teams.
 *   Unauthenticated users have no access. Further access control can be refined by using the 'role' field in user objects.
 *
 * Data Structure:
 *   - /gameSessions/{gameSessionId}: Stores game session data.
 *   - /teams/{teamId}: Stores team data.
 *
 * Key Security Decisions:
 *   - Only authenticated users can create game sessions and teams.
 *   - No listing of any collections is allowed.
 *   - Validation is limited to checking the authentication state of the user and the existence of documents before updates or deletes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the /gameSessions collection.
     * @path /gameSessions/{gameSessionId}
     * @allow (create) Authenticated user can create a game session.
     * @deny (create) Unauthenticated user cannot create a game session.
     * @allow (get) Not allowed.
     * @deny (get) Not allowed.
     * @principle Only authenticated users can create game sessions.
     */
    match /gameSessions/{gameSessionId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to the /teams collection.
     * @path /teams/{teamId}
     * @allow (create) Authenticated user can create a team.
     * @deny (create) Unauthenticated user cannot create a team.
     * @allow (get) Not allowed.
     * @deny (get) Not allowed.
     * @principle Only authenticated users can create teams.
     */
    match /teams/{teamId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}