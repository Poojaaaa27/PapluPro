/**
 * @fileoverview Firestore Security Rules for Paplu Pro.
 *
 * Core Philosophy:
 * This ruleset prioritizes a completely open access model. All reads and writes are allowed for all users, regardless of authentication status.
 *
 * Data Structure:
 * Data is stored in two top-level collections: `/gameSessions/{gameSessionId}` and `/teams/{teamId}`.
 *
 * Key Security Decisions:
 * Due to the "reverse this firebase thing" instruction, all security measures have been removed, effectively making the database public and writable by anyone.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows any user to read or write game session data.
     * @path /gameSessions/{gameSessionId}
     * @allow (get, list) Any user can read game session data.
     * @allow (create, update, delete) Any user can write game session data.
     * @principle Public access for all operations.
     */
    match /gameSessions/{gameSessionId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }

    /**
     * @description Allows any user to read or write team data.
     * @path /teams/{teamId}
     * @allow (get, list) Any user can read team data.
     * @allow (create, update, delete) Any user can write team data.
     * @principle Public access for all operations.
     */
    match /teams/{teamId} {
      allow get, list: if true;
      allow create, update, delete: if true;
    }
  }
}