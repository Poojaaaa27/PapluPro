/**
 * @fileoverview Firestore Security Rules for Paplu Pro.
 *
 * Core Philosophy:
 * This ruleset provides open read access to game sessions and teams,
 * but restricts write access.
 *
 * Data Structure:
 * - /gameSessions/{gameSessionId}: Stores data for individual game sessions.
 * - /teams/{teamId}: Stores data for teams.
 *
 * Key Security Decisions:
 * - Listing game sessions and teams is allowed for all users (including unauthenticated users).
 * - Write permissions for game sessions and teams are denied to all users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read game session data, but nobody to modify it.
     * @path /gameSessions/{gameSessionId}
     * @allow (get, list): Any user can read a game session.
     * @deny (create, update, delete): No user can create, update, or delete a game session.
     * @principle Allows public read access while restricting write access.
     */
    match /gameSessions/{gameSessionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows anyone to read team data, but nobody to modify it.
     * @path /teams/{teamId}
     * @allow (get, list): Any user can read a team.
     * @deny (create, update, delete): No user can create, update, or delete a team.
     * @principle Allows public read access while restricting write access.
     */
    match /teams/{teamId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}