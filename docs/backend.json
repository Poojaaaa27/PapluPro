{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user within the Paplu Pro application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user."
        },
        "username": {
          "type": "string",
          "description": "User's username for login."
        },
        "email": {
          "type": "string",
          "description": "User's email address.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "User's role (organizer, player, viewer).",
          "format": "string"
        }
      },
      "required": [
        "id",
        "username",
        "email",
        "role"
      ]
    },
    "GameSession": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GameSession",
      "type": "object",
      "description": "Represents a single game session.",
      "properties": {
        "location": {
          "type": "string",
          "description": "The location where the game session took place."
        },
        "date": {
          "type": "string",
          "description": "The date of the game session.",
          "format": "date-time"
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Player"
          }
        },
        "rounds": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Round"
          }
        },
        "status": {
          "type": "string"
        },
        "teamName": {
          "type": "string"
        }
      },
      "required": [
        "location",
        "date",
        "players",
        "rounds",
        "status",
        "teamName"
      ]
    },
    "Round": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Round",
      "type": "object",
      "description": "Represents a single round within a game session.",
      "properties": {
        "id": {
          "type": "number"
        },
        "playerStatus": {
          "type": "object"
        },
        "scores": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "playerStatus",
        "scores"
      ]
    },
    "Player": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Player",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"]
    },
    "Team": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Team",
      "type": "object",
      "description": "Represents a team of players.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the team."
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/entities/Player"
          },
          "description": "A list of players in the team."
        }
      },
      "required": [
        "name",
        "players"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/gameSessions/{gameSessionId}": {
      "schema": {
        "$ref": "#/entities/GameSession"
      },
      "description": "Stores all game session data."
    },
    "/teams/{teamId}": {
      "schema": {
        "$ref": "#/entities/Team"
      },
      "description": "Stores all team data."
    }
  }
}
